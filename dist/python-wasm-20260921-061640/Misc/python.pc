# See: man pkg-config
prefix=/workspaces/MyPython/cpython/cross-build/emsdk/6.0.9/prefix
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Python
Description: Build a C extension for Python
Requires:
Version: 3.16
Libs.private: -ldl  -lpthread
Libs: -L${libdir} 
Cflags: -I${includedir}/python3.16
